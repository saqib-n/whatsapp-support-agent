# LLM provider, pick one and fill in its key
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# "<provider>:<model>", e.g. openai:gpt-5.5, anthropic:claude-opus-5-5 or google_genai:gemini-3.5-flash
LLM_MODEL=openai:gpt-5.5

# WhatsApp Cloud API (only needed to connect a real WhatsApp number,
# not needed for simulate_chat.py)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=choose-any-random-string-yourself
# App secret from the Meta app's Basic settings. When set, the webhook
# rejects any POST that isn't signed by Meta. Set it before going live.
WHATSAPP_APP_SECRET=
# Optional, Graph API version for sending, bump it when Meta retires this one
WHATSAPP_GRAPH_API_VERSION=v23.0
